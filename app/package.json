{
  "name": "video-behavior-annotation",
  "private": true,
  "version": "0.1.0",
  "description": "Local video behavior annotation tool for meeting experiments",
  "author": "Behavior Annotation Lab",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-check --tsconfig ./tsconfig.json && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "ffmpeg-static": "latest",
    "svelte": "latest",
    "zod": "latest",
    "@fontsource-variable/dm-sans": "latest",
    "@fontsource-variable/noto-sans-jp": "latest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "latest",
    "electron": "latest",
    "electron-vite": "latest",
    "typescript": "latest",
    "electron-builder": "latest",
    "vitest": "latest",
    "svelte-check": "latest",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "jp.ac.tmu.behaviorannotation",
    "productName": "Behavior Annotation Desk",
    "directories": { "output": "release" },
    "files": ["out/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.video" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": "AppImage", "category": "Video" }
  }
}
